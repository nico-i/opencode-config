{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/claude-sonnet-5.5",
  "compaction": {
    "auto": true,
    "buffer": 12000
  },
  "update": "notify",
  "share": "disabled",
  "formatter": true,
  "default_agent": "plan",
  "experimental": {
    "todo": true,
    "policies": [
      {
        "effect": "deny",
        "action": "provider.use",
        "resource": "*"
      },
      {
        "effect": "allow",
        "action": "provider.use",
        "resource": "github-copilot"
      },
      {
        "effect": "deny",
        "action": "tool.use",
        "resource": "shell:sudo*"
      },
      {
        "effect": "deny",
        "action": "tool.use",
        "resource": "shell:wget*"
      },
      {
        "effect": "deny",
        "action": "tool.use",
        "resource": "shell:chmod*"
      },
      {
        "effect": "deny",
        "action": "tool.use",
        "resource": "shell:chown*"
      },
      {
        "effect": "deny",
        "action": "tool.use",
        "resource": "edit:**/*.env*"
      }
    ]
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "curl -fsS http://127.0.0.1:8787/stats",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "fd *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "test *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "projectatlas *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "PROJECTATLAS_NO_TELEMETRY=1 projectatlas *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gitlab ci lint *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "PROJECTATLAS_NO_TELEMETRY=1 projectatlas --format json runtime-info",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "wc *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "rg *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "awk *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "find *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "grep *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "fold *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "head *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "tail *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "sort *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "ls*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "jq *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "jar *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "pwd",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "echo *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "which *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "diff *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git status *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff-tree *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git log *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git show *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git branch *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git remote *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "glab auth status",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "glab *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "glab --help *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "glab --version *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "glab help *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "glab version *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "glab auth status *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "glab check-update *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "glab iteration list *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "glab iteration get *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "glab issue list *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "glab issue view *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "glab job get *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "glab job list *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "glab label list *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "glab milestone list *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "glab milestone view *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "glab mr checks *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "glab mr diff *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "glab mr list *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "glab mr view *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "glab release list *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "glab release view *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "glab repo list *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "glab repo view *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "glab runner list *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "glab schedule list *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "glab search *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "glab user get *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "glab user list *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "glab variable get *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "glab variable list *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "./gradlew *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "headroom *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "mvn *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "vp *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "pnpm run *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "npm view *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "python3 *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "python *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "ruby *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "perl *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "cat *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "kubectl delete*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "kubectl apply*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "kubectl edit*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "kubectl patch*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "**/*.env*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.example",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "gradle.properties",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": ".zshrc",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": ".bashrc",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": ".bash_profile",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": ".ssh/*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": ".git-credentials",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": ".aws/*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": ".npmrc",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": ".m2/settings.xml",
      "effect": "deny"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "webfetch",
      "resource": "http://127.0.0.1:8787/stats",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    }
  ],
  "agents": {
    "build": {
      "mode": "primary",
      "model": "github-copilot/claude-sonnet-5.5",
      "variant": "low"
    },
    "plan": {
      "mode": "primary",
      "model": "github-copilot/claude-sonnet-5.5",
      "variant": "low"
    },
    "title": {
      "model": "github-copilot/gpt-6.1-mini",
      "variant": "low"
    }
  },
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "/Users/nico/.config/opencode/plugins/headroom-copilot"
  ],
  "mcp": {
    "servers": {
      "vercelGrep": {
        "type": "remote",
        "url": "https://mcp.grep.app"
      },
      "gitDocsMCP": {
        "type": "remote",
        "url": "https://gitmcp.io/docs"
      },
      "snowball": {
        "type": "remote",
        "url": "https://snowball-mcp.ops-wirk.narf.tech/mcp"
      },
      "congstar-backstage": {
        "type": "remote",
        "url": "https://backstage.itg-wirk.narf.tech/api/mcp-actions/v1"
      }
    }
  },
  "provider": {
    "headroom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Headroom Proxy",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1"
      }
    }
  }
}
